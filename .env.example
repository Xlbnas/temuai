# TEMU Image Factory - 环境变量示例
# 复制本文件为 .env 并填入真实值
# 绝对不要把 .env 提交到 Git

# ==================== 应用安全 ====================
APP_USERNAME=admin
APP_PASSWORD_HASH=
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_MAX_AGE_HOURS=24
COOKIE_SECURE=false

# ==================== Docker / NAS ====================
PUID=1000
PGID=1000
MAX_UPLOAD_MB=30
# 仅在可信反向代理（HTTPS）之后设为 true，否则保持 false
TRUST_PROXY_HEADERS=false

# ==================== API易 (APIYI) ====================
APIYI_API_KEY=
APIYI_GEMINI_BASE_URL=https://api.apiyi.com
APIYI_OPENAI_BASE_URL=https://api.apiyi.com/v1
APIYI_BACKUP_BASE_URL=https://b.apiyi.com

# ==================== 可选：未来 ComfyUI ====================
COMFYUI_BASE_URL=
